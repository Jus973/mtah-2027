{
  "permissions": {
    "allow": [
      "Bash(make airlock:*)"
    ],
    "deny": [
      "Read(./data/**)",
      "Read(./cache/**)",
      "Read(/Users/justinzhang/mtah2027/**)",
      "Read(/Users/justinzhang/mtah2027_cache/**)",
      "Read(./submissions/candidates/**)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(less:*)",
      "Bash(more:*)",
      "Bash(strings:*)",
      "Bash(xxd:*)",
      "Bash(ffmpeg:*)",
      "Bash(ffplay:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__terminal__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_data.py\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/board_sync.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/board_sync.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
